import React, { useState, useMemo, useEffect } from 'react';
import { useTopbarActions } from '@/shared/context/TopbarActionContext';
import { useDebounce } from '@/shared/hooks/useDebounce';
import { DataPageTemplate } from '@/components/ui/data-page-template';
import { zodResolver } from '@hookform/resolvers/zod';
import {
    use{{pascalCase name}}Create,
    use{{pascalCase name}}Delete,
    use{{pascalCase name}}Index,
    use{{pascalCase name}}Update,
} from '@/services/{{kebabCase pluralName}}/hooks/use{{pascalCase name}}CRUD';
import {
    {{pascalCase name}}CreatePayload,
    {{pascalCase name}}CreateSchema,
    {{pascalCase name}}Entity,
} from '@/services/{{kebabCase pluralName}}/schema/{{pascalCase name}}Schema';
import {{pascalCase name}}MutationForm from './{{pascalCase name}}MutationForm';

const {{pascalCase name}}MainContent: React.FC = () => {
    const [search, setSearch] = useState('');
    const debouncedSearch = useDebounce(search, 500);
